[Unit]
Description=Keirin daily collection (yesterday + missed days)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/keirin
ExecStart=/usr/bin/flock -n /home/ubuntu/keirin/data/daily.lock /home/ubuntu/keirin/venv/bin/python /home/ubuntu/keirin/daily_collect.py
Nice=10
